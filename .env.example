# Cấu hình Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Cấu hình Thị trường & Nguồn dữ liệu (Hỗ trợ 1 hoặc nhiều tài sản cách nhau bởi dấu phẩy)
# Ví dụ: SYMBOLS=XAU/USD,ETH/USDT,BTC/USDT hoặc SYMBOL=XAU/USD
SYMBOLS=XAU/USD,ETH/USDT
SYMBOL=XAU/USD
TIMEFRAME=15m
HIGHER_TIMEFRAME=1h
CRON_SCHEDULE=*/5 * * * *
MIN_CONFLUENCE_SCORE=65

# Nguồn dữ liệu nến: TRADINGVIEW (Khuyên dùng: Chuẩn 100% Forex) | BINANCE
MARKET_DATA_SOURCE=TRADINGVIEW
# Ticker TradingView: OANDA:XAUUSD | TVC:GOLD | FX:XAUUSD | FOREXCOM:XAUUSD
TRADINGVIEW_SYMBOL=OANDA:XAUUSD
# Độ lệch bù trừ giá thủ công nếu cần (Mặc định: 0)
PRICE_OFFSET=0

# Cấu hình AI Assistant (Google Gemini)
# Lấy API Key miễn phí tại: https://aistudio.google.com/
# Các model: gemini-3.8-flash | gemini-3.7-flash | gemini-3.5-flash
# MẸO TRÁNH RATE LIMIT: Có thể nhập nhiều API Key cách nhau bởi dấu phẩy (GEMINI_API_KEY hoặc GEMINI_API_KEYS).
# Bot sẽ tự động xoay tua (Round-Robin) chia tải và tự động đổi key khi bị dính lỗi 429/Quota.
# Ví dụ: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
AI_FILTER_ENABLED=true
AI_MIN_CONFIDENCE=75

# Ngưỡng điểm chất lượng chiến lược tối thiểu để phát tín hiệu (0 - 100, khuyên dùng: 70)
MIN_STRATEGY_SCORE=70

# Không phát lại tín hiệu cùng chiều trên cùng tài sản trong N nến (mặc định 4 nến = 1 giờ với khung 15m)
SIGNAL_COOLDOWN_BARS=4
# Giờ UTC reset VWAP theo phiên (0 = 00:00 UTC cho Crypto; Vàng/Forex có thể dùng 22)
VWAP_SESSION_UTC_HOUR=0
