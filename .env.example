# Cấu hình Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Cấu hình Thị trường & Nguồn dữ liệu (Hỗ trợ 1 hoặc nhiều tài sản cách nhau bởi dấu phẩy)
# Ví dụ: SYMBOLS=XAU/USD,ETH/USDT,BTC/USDT hoặc SYMBOL=XAU/USD
SYMBOLS=XAU/USD,ETH/USDT
SYMBOL=XAU/USD
TIMEFRAME=15m
HIGHER_TIMEFRAME=1h
CRON_SCHEDULE=*/5 * * * *
MIN_CONFLUENCE_SCORE=65

# Nguồn dữ liệu nến: TRADINGVIEW (Khuyên dùng: Chuẩn 100% Forex) | BINANCE
MARKET_DATA_SOURCE=TRADINGVIEW
# Ticker TradingView: OANDA:XAUUSD | TVC:GOLD | FX:XAUUSD | FOREXCOM:XAUUSD
TRADINGVIEW_SYMBOL=OANDA:XAUUSD
# Độ lệch bù trừ giá thủ công nếu cần (Mặc định: 0)
PRICE_OFFSET=0

# Cấu hình AI Assistant (Google Gemini)
# Lấy API Key miễn phí tại: https://aistudio.google.com/
# Các model: gemini-3.8-flash | gemini-3.7-flash | gemini-3.5-flash
# MẸO TRÁNH RATE LIMIT: Có thể nhập nhiều API Key cách nhau bởi dấu phẩy (GEMINI_API_KEY hoặc GEMINI_API_KEYS).
# Bot sẽ tự động xoay tua (Round-Robin) chia tải và tự động đổi key khi bị dính lỗi 429/Quota.
# Ví dụ: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
AI_FILTER_ENABLED=true
AI_MIN_CONFIDENCE=75

# Ngưỡng điểm chất lượng chiến lược tối thiểu để phát tín hiệu (0 - 100, khuyên dùng: 70)
MIN_STRATEGY_SCORE=70

# Không phát lại tín hiệu cùng chiều trên cùng tài sản trong N nến (mặc định 4 nến = 1 giờ với khung 15m)
SIGNAL_COOLDOWN_BARS=4
# Giờ UTC reset VWAP theo phiên cho Crypto (mặc định 0 = 00:00 UTC như TradingView).
# Vàng/Forex luôn reset lúc 17:00 New York (tự theo giờ mùa hè/đông), không dùng biến này.
VWAP_SESSION_UTC_HOUR=0

# Dashboard thống kê tín hiệu: http://<host>:3000/dashboard
# Lệnh chưa chạm TP1/SL sau N nến thì chốt theo giá đóng cửa (mặc định 48 nến = 12 giờ với khung 15m)
SIGNAL_TRACK_HORIZON_BARS=48
# Nơi lưu file thống kê (mặc định data/signals.json trong thư mục dự án)
# SIGNAL_DB_PATH=/app/data/signals.json
# Đặt token để bảo vệ dashboard, khi đó mở bằng /dashboard?token=<giá trị>
DASHBOARD_TOKEN=

# Lịch tin tức kinh tế (ForexFactory): nhắn Telegram trước giờ ra tin & chặn tín hiệu quanh giờ ra tin
NEWS_ENABLED=true
# Tiền tệ theo dõi, cách nhau bởi dấu phẩy (vd: USD hoặc USD,EUR)
NEWS_CURRENCIES=USD
# Mức tác động: High | Medium | Low (vd: High,Medium để theo dõi cả tin trung bình)
NEWS_IMPACTS=High
# Nhắn Telegram trước giờ ra tin N phút
NEWS_ALERT_MINUTES=30
# Không phát tín hiệu trong khoảng ±N phút quanh giờ ra tin (0 = không chặn)
NEWS_BLACKOUT_MINUTES=30

# Phương pháp và khung thời gian chạy: "tên@khung" cách nhau bởi dấu phẩy (thiếu "@khung" thì dùng TIMEFRAME).
# Tên: trend-following, mean-reversion, volatility-breakout, smc-lite, rsi-divergence, smart-money-flow,
#      order-flow, donchian-55, supertrend. Xem dashboard > Báo cáo backtest để biết phương pháp nào đạt chuẩn ở khung nào.
# Mặc định (bỏ trống): 6 phương pháp cũ ở TIMEFRAME (tắt order-flow vì lỗ ở gần như mọi khung)
#   + donchian-55@2h, donchian-55@4h, donchian-55@1d, supertrend@1d
# Ví dụ chỉ chạy Donchian 2h và 4h: STRATEGIES=donchian-55@2h,donchian-55@4h
# Thêm Donchian 1h (đạt chuẩn sát ngưỡng, đang lỗ vài tháng gần nhất): thêm ",donchian-55@1h" vào danh sách mặc định
# STRATEGIES=

# Báo cáo backtest trên dashboard: tạo khi khởi động (nếu chưa có hoặc cũ hơn 7 ngày) và định kỳ ở tiến trình riêng.
# Chạy tay: npm run backtest:report
BACKTEST_REPORT_ENABLED=true
# Mặc định 9:00 Chủ nhật (giờ server) khi thị trường Vàng nghỉ
BACKTEST_REPORT_CRON=0 9 * * 0
BACKTEST_REPORT_TIMEFRAMES=15m,30m,1h,2h,4h,1d
