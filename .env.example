# Cấu hình Telegram Bot
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Cấu hình Thị trường Vàng (Mặc định: XAU/USD Spot Gold Realtime)
SYMBOL=XAU/USD
TIMEFRAME=15m
HIGHER_TIMEFRAME=1h
CRON_SCHEDULE=*/5 * * * *

# Cấu hình AI Assistant (Google Gemini)
# Lấy API Key miễn phí tại: https://aistudio.google.com/
# Các model: gemini-3.8-flash | gemini-3.7-flash | gemini-3.5-flash
# MẸO TRÁNH RATE LIMIT: Có thể nhập nhiều API Key cách nhau bởi dấu phẩy (GEMINI_API_KEY hoặc GEMINI_API_KEYS).
# Bot sẽ tự động xoay tua (Round-Robin) chia tải và tự động đổi key khi bị dính lỗi 429/Quota.
# Ví dụ: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
AI_FILTER_ENABLED=true
AI_MIN_CONFIDENCE=75

# Ngưỡng điểm chất lượng chiến lược tối thiểu để phát tín hiệu (0 - 100, khuyên dùng: 70)
MIN_STRATEGY_SCORE=70

# ==============================================================
# CẤU HÌNH BOT SCALPING 1 PHÚT (CHỐT LỜI 1 GIÁ - feat/add-trade-one-price)
# Chạy độc lập qua lệnh: pnpm run scalp (hoặc node bot-scalp.js)
# ==============================================================
# Mục tiêu chốt lời (Mặc định 1.00 USD / 1 giá)
SCALP_TAKE_PROFIT=1.0

# Mức cắt lỗ theo người dùng tùy chỉnh (ví dụ: 1.0, 1.5, 2.0 giá)
SCALP_STOP_LOSS=3

# Chu kỳ kiểm tra giá realtime giám sát TP/SL (tính bằng giây, mặc định 3 giây)
SCALP_CHECK_INTERVAL_SEC=3

# Ngưỡng điểm chất lượng tín hiệu 1m tối thiểu (0 - 100, mặc định 70)
SCALP_MIN_SCORE=70

# Cổng port web server cho bot scalping (tránh đụng cổng 3000 của bot chính khi chạy song song)
SCALP_PORT=3001

# ==============================================================
# CẤU HÌNH KẾT NỐI EXNESS MT5 (TỰ ĐỘNG BẮN LỆNH THẬT / DEMO QUA METAAPI)
# Đăng ký miễn phí 1 account tại: https://app.metaapi.cloud
# Nếu để trống, bot tự động chạy ở chế độ Paper Trading (Giả lập)
# ==============================================================
META_API_TOKEN=YOUR_META_API_TOKEN_HERE
META_API_ACCOUNT_ID=YOUR_META_API_ACCOUNT_ID_HERE
EXNESS_SYMBOL=XAUUSD
EXNESS_LOT_SIZE=0.01


